<Window x:Class="WpfCodeReview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI PR Code Review Tool"
        Height="820" Width="1160"
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Window.Resources>
        <!-- Label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Text input style -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- PasswordBox style -->
        <Style x:Key="PasswordInput" TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- ComboBox style -->
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BBBBBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#C42B1C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A12116"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#5C6370"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#464D57"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success button -->
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#107C10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0A5E0A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GroupBox style -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12" Foreground="#333"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox style -->
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="#0078D4" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="🤖  AI PR Code Review Tool"
                           Foreground="White" FontSize="19" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="TxtVersion"
                           Foreground="#B0D4F0" FontSize="12"
                           VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- ===== Main TabControl ===== -->
        <TabControl Grid.Row="1" Margin="10,10,10,0"
                    Background="White"
                    BorderBrush="#DDDDDD">

            <!-- ─────────────────────────────── Tab 1: Code Review ─────────────────────────────── -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="  🔍  Code Review  " FontSize="13"/>
                </TabItem.Header>

                <Grid Margin="12,10,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Working Directory -->
                    <GroupBox Grid.Row="0" Header="工作目錄 (dist/index.js 所在目錄)" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtWorkingDir" Grid.Column="0"
                                     Style="{StaticResource Input}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="瀏覽..."
                                    Style="{StaticResource SecondaryBtn}"
                                    Click="BtnBrowseDir_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- DevOps Quick Settings -->
                    <GroupBox Grid.Row="1" Header="DevOps 連線設定" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: OrgUrl + AccessToken -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Org URL:" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtOrgUrl" Style="{StaticResource Input}"/>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Access Token:" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox Grid.Row="0" Grid.Column="4"
                                         x:Name="PwdAccessToken"
                                         Style="{StaticResource PasswordInput}"/>

                            <!-- Row 2: Project + RepositoryId + PRId -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Project:" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtProject" Style="{StaticResource Input}"/>

                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Repository ID:" Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Row="2" Grid.Column="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtRepositoryId" Style="{StaticResource Input}"/>
                                <TextBlock Grid.Column="2" Text="PR ID:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="3" x:Name="TxtPRId" Style="{StaticResource Input}"/>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <!-- Console Area -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Action bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="BtnRun"
                                    Content="▶  開始審查"
                                    Width="140"
                                    Style="{StaticResource PrimaryBtn}"
                                    Click="BtnRun_Click"/>

                            <Button Grid.Column="2" x:Name="BtnStop"
                                    Content="■  停止"
                                    Width="100"
                                    Style="{StaticResource DangerBtn}"
                                    IsEnabled="False"
                                    Click="BtnStop_Click"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                         Fill="#999" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtRunStatus"
                                           FontSize="12" Foreground="#555"
                                           VerticalAlignment="Center"
                                           Text="就緒 Ready"/>
                            </StackPanel>

                            <Button Grid.Column="4" Content="清除輸出"
                                    Style="{StaticResource SecondaryBtn}"
                                    Click="BtnClear_Click"/>
                        </Grid>

                        <!-- Search bar -->
                        <Border Grid.Row="1" Background="#2A2A2A"
                                BorderBrush="#3C3C3C" BorderThickness="1,0,1,0"
                                Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" Foreground="#888"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="TxtSearch"
                                         Background="#3C3C3C" Foreground="#D4D4D4" CaretBrush="#D4D4D4"
                                         BorderBrush="#555555" BorderThickness="1"
                                         Padding="6,4" FontSize="12"
                                         FontFamily="Cascadia Code, Consolas, Courier New"
                                         TextChanged="TxtSearch_TextChanged"
                                         KeyDown="TxtSearch_KeyDown"/>
                                <Button Grid.Column="3" Content="↑" Padding="10,5"
                                        Style="{StaticResource SecondaryBtn}"
                                        ToolTip="上一個 (Shift+Enter)"
                                        Click="BtnFindPrev_Click"/>
                                <Button Grid.Column="5" Content="↓" Padding="10,5"
                                        Style="{StaticResource SecondaryBtn}"
                                        ToolTip="下一個 (Enter)"
                                        Click="BtnFindNext_Click"/>
                                <TextBlock x:Name="TxtSearchResult" Grid.Column="7"
                                           Foreground="#888" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Console output -->
                        <Border Grid.Row="2" Background="#1E1E1E"
                                BorderBrush="#3C3C3C" BorderThickness="1"
                                CornerRadius="4">
                            <TextBox x:Name="TxtConsole"
                                     Background="Transparent"
                                     Foreground="#D4D4D4"
                                     CaretBrush="#D4D4D4"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="12"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Padding="12"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     SelectionBrush="#E8A400"
                                     SelectionOpacity="0.7"
                                     IsInactiveSelectionHighlightEnabled="True"/>
                        </Border>

                        <!-- Console footer -->
                        <Grid Grid.Row="3" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtLineCount"
                                       Grid.Column="0"
                                       FontSize="11" Foreground="#888"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       FontSize="11" Foreground="#888"
                                       Text="Wrap 模式 | 只讀"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ─────────────────────────────── Tab 2: Settings ─────────────────────────────── -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="  ⚙️  設定 Settings  " FontSize="13"/>
                </TabItem.Header>

                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,10,12,6">

                            <!-- AI Provider Settings -->
                            <GroupBox Header="AI 提供者設定 (AI Provider)" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Provider + ModelName -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="AI Provider:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CmbAiProvider" Style="{StaticResource Combo}">
                                        <ComboBoxItem>Google</ComboBoxItem>
                                        <ComboBoxItem>OpenAI</ComboBoxItem>
                                        <ComboBoxItem>Grok</ComboBoxItem>
                                        <ComboBoxItem>Claude</ComboBoxItem>
                                        <ComboBoxItem>GitHubCopilot</ComboBoxItem>
                                        <ComboBoxItem>Ollama</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Model Name:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="4" x:Name="TxtModelName" Style="{StaticResource Input}"/>

                                    <!-- Row 2: Gemini + OpenAI keys -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gemini API Key:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtGeminiKey" Style="{StaticResource Input}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="OpenAI API Key:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="4" x:Name="TxtOpenAIKey" Style="{StaticResource Input}"/>

                                    <!-- Row 4: Grok + Claude keys -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Grok API Key:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtGrokKey" Style="{StaticResource Input}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Claude API Key:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="4" Grid.Column="4" x:Name="TxtClaudeKey" Style="{StaticResource Input}"/>

                                    <!-- Row 6: Copilot Token + Server -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Copilot Token:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TxtCopilotToken" Style="{StaticResource Input}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="3" Text="Copilot Server:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="6" Grid.Column="4" x:Name="TxtCopilotServer" Style="{StaticResource Input}"/>

                                    <!-- Row 8: Ollama + CopilotTimeout -->
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Ollama Base URL:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="8" Grid.Column="1" x:Name="TxtOllamaUrl" Style="{StaticResource Input}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="3" Text="Copilot Timeout (ms):" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="8" Grid.Column="4" x:Name="TxtCopilotTimeout" Style="{StaticResource Input}"/>
                                </Grid>
                            </GroupBox>

                            <!-- AI Generation Settings -->
                            <GroupBox Header="AI 生成設定 (Generation)" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Instruction Source:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CmbInstructionSource" Style="{StaticResource Combo}">
                                        <ComboBoxItem>Built-in</ComboBoxItem>
                                        <ComboBoxItem>Inline</ComboBoxItem>
                                        <ComboBoxItem>File</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Response Language:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="4" x:Name="TxtResponseLanguage" Style="{StaticResource Input}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Temperature (0~1):" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtTemperature" Style="{StaticResource Input}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Max Output Tokens:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="4" x:Name="TxtMaxTokens" Style="{StaticResource Input}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="System Instruction:" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                               x:Name="TxtSystemInstruction"
                                               Style="{StaticResource Input}"
                                               Height="56" TextWrapping="Wrap"
                                               AcceptsReturn="True"
                                               VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </GroupBox>

                            <!-- Review Mode & Inline Comment -->
                            <GroupBox Header="審查模式 &amp; 行內評論 (Review Mode)" Margin="0,0,0,10">
                                <WrapPanel>
                                    <CheckBox x:Name="ChkThrottleMode"      Content="EnableThrottleMode"/>
                                    <CheckBox x:Name="ChkShowReviewContent" Content="ShowReviewContent"/>
                                    <CheckBox x:Name="ChkIncrementalDiff"   Content="EnableIncrementalDiff"/>
                                    <CheckBox x:Name="ChkWriteReviewResult" Content="WriteReviewResult"/>
                                    <CheckBox x:Name="ChkInlineComments"    Content="EnableInlineComments"/>
                                    <CheckBox x:Name="ChkGroupInlineComments" Content="GroupInlineCommentsByFile"/>
                                    <CheckBox x:Name="ChkInlineStrictMode" Content="InlineStrictMode"/>
                                </WrapPanel>
                            </GroupBox>

                            <!-- Diff Filter -->
                            <GroupBox Header="差異過濾設定 (Diff Filter)" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="File Extensions:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Column="1" x:Name="TxtFileExtensions" Style="{StaticResource Input}"/>
                                    <TextBlock Grid.Column="3" Text="Binary Extensions:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Column="4" x:Name="TxtBinaryExtensions" Style="{StaticResource Input}"/>
                                </Grid>
                            </GroupBox>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings Save Button -->
                    <Border Grid.Row="1" Background="#F8F8F8"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0"
                            Padding="12,10">
                                                <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="TxtSettingsSaveHint"
                                       FontSize="11" Foreground="#888"
                                       VerticalAlignment="Center"
                                       Text="設定儲存於 %AppData%\WpfCodeReview\settings.json"/>
                            <Button Grid.Column="1"
                                    Content="[匯入] 匯入 .env"
                                    Style="{StaticResource SecondaryBtn}"
                                    Click="BtnImportEnv_Click"/>
                            <Button Grid.Column="3"
                                    Content="[匯出] 匯出 .env"
                                    Style="{StaticResource SecondaryBtn}"
                                    Click="BtnExportEnv_Click"/>
                            <Button Grid.Column="5"
                                    Content="[儲存] 儲存設定"
                                    Style="{StaticResource SuccessBtn}"
                                    Click="BtnSaveSettings_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ===== Status Bar ===== -->
        <Border Grid.Row="2"
                Background="#EEEEEE"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusBar"
                           Grid.Column="0"
                           FontSize="11" Foreground="#555"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           FontSize="11" Foreground="#AAA"
                           Text="AI PR Code Review Tool  |  WPF Dev Runner"/>
            </Grid>
        </Border>

    </Grid>
</Window>
